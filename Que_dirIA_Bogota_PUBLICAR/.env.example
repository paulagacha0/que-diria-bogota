# OPCIONAL: configurar una clave de Gemini como variable de entorno del sistema.
# Windows PowerShell (antes de ejecutar):
# $env:GEMINI_API_KEY="tu_clave"
# python server.py
# Linux/Mac:
# GEMINI_API_KEY="tu_clave" python3 server.py
# Nunca subas claves a GitHub ni las incluyas en el frontend.
GEMINI_MODEL=gemini-2.5-flash
